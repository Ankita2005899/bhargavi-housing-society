# Copy this file to .env for local development (Render uses its own
# Environment tab instead — set the same keys there).

# Postgres connection string (Neon, Render Postgres, or local)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random long string — used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string

# The Secretary account is created automatically the first time the
# server boots against a fresh database. Change the password afterwards
# from a real login, not by editing this file again — it's only read once.
SECRETARY_EMAIL=secretary@bhargavihousing.example
SECRETARY_PASSWORD=ChangeMe123!

PORT=3000
NODE_ENV=production
